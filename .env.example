# Max number of days into the future a discovered event may start before it
# is excluded from the discovery window (see lib/config/discovery-config.ts).
MAX_FUTURE_DAYS=180

OPENAPI_GEOCODING_KEY=

# Optional: number of Luma pages fetched per category slug (default: 5)
LUMA_MAX_PAGES_PER_SLUG=

# Optional: minimum minutes between /api/update runs (issue #77). Guards
# against back-to-back manual triggers (trigger-update.mjs --live, the dev
# "Aggiorna ora" button, a direct curl) re-hitting already-rate-limited
# sources like Eventbrite's directory pages. Checked against the most
# recent public.update_runs row's finished_at (or started_at if it's still
# running) before a new run starts; a request inside the window gets a 429
# with a clear JSON explanation instead of running. Default: 5. The daily
# cron (.github/workflows/update.yml) runs hours apart and is never
# affected by this in normal operation. Set to 0 to disable.
MIN_UPDATE_INTERVAL_MINUTES=

# Web-search discovery (issue #13/#14/#17): free-tier search providers used in
# fallback order (Tavily first, then SerpAPI, then Serper) so no single
# provider's free quota blocks a whole pipeline run. All optional individually,
# but at least one is needed for web-search-based discovery to run at all.
TAVILY_API_KEY=
SERPAPI_API_KEY=
SERPER_API_KEY=

# Optional: persistent daily cap (issue #18) on how many web-search queries
# scripts/discover-web-candidates.ts is allowed to issue per UTC day, shared
# across separate runs via a local .discovery-budget.json file. Default: 30.
DISCOVERY_DAILY_QUERY_BUDGET=

# Optional: LLM-assisted pre-screening on the Pending tab of
# /admin/candidates (issue #17). A free-tier Gemini Flash API key
# (https://aistudio.google.com/apikey) - when unset, the moderation queue
# works exactly as it does today, with no suggestion shown and no error.
# Never used to auto-approve/reject anything; it only shows a
# suggestion-only badge next to the existing Approve/Reject actions.
GEMINI_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth for /admin/candidates and /admin/hackathons (issue #67 - see docs/admin-auth-setup.md
# for the full walkthrough). GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET come from
# a Google Cloud OAuth 2.0 Client ID (web application type) and are read by
# supabase/config.toml's [auth.external.google] section - restart
# `npx supabase start` after setting them. ADMIN_ALLOWED_EMAIL is the single
# Google account allowed to sign in; if unset, both admin pages deny everyone
# (fail closed). The pages are also disabled whenever NODE_ENV=production,
# which includes Vercel Preview deployments.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_ALLOWED_EMAIL=

# Local-only admin auth bypass (issue #4): skips the Google sign-in gate
# entirely and treats every request to /admin and /admin/candidates as
# authorized. Only ever honored when NODE_ENV !== "production" (hardcoded in
# lib/services/require-admin-auth.ts, not just implied by this var being
# unset) - a production deploy can never trigger this bypass no matter how
# it's misconfigured. Leaving GOOGLE_CLIENT_ID/ADMIN_ALLOWED_EMAIL unset
# already enables this automatically in development (real sign-in couldn't
# work without them anyway); set ADMIN_LOCAL_NO_AUTH=true explicitly if you
# want the bypass even with those configured. See docs/admin-auth-setup.md.
ADMIN_LOCAL_NO_AUTH=

DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

GITHUB_TOKEN=

CRON_SECRET=

# Optional error tracking (issue #9). Sentry is completely disabled when
# these DSNs are empty. Error capture only: no user analytics, session replay,
# performance tracing, or default PII.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
