# Max number of days into the future a discovered event may start before it
# is excluded from the discovery window (see lib/config/discovery-config.ts).
MAX_FUTURE_DAYS=180

OPENAPI_GEOCODING_KEY=

# Optional: number of Luma pages fetched per category slug (default: 5)
LUMA_MAX_PAGES_PER_SLUG=

# Web-search discovery (issue #13/#14/#17): free-tier search providers used in
# fallback order (Tavily first, then SerpAPI, then Serper) so no single
# provider's free quota blocks a whole pipeline run. All optional individually,
# but at least one is needed for web-search-based discovery to run at all.
TAVILY_API_KEY=
SERPAPI_API_KEY=
SERPER_API_KEY=

# Optional: persistent daily cap (issue #18) on how many web-search queries
# scripts/discover-web-candidates.ts is allowed to issue per UTC day, shared
# across separate runs via a local .discovery-budget.json file. Default: 30.
DISCOVERY_DAILY_QUERY_BUDGET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

GITHUB_TOKEN=

CRON_SECRET=